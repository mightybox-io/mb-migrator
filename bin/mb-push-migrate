#!/usr/bin/env bash
set -euo pipefail
umask 077

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
source "$ROOT_DIR/lib/util.sh"
set_log_context push setup

usage() {
  cat <<'EOF'
Outbound SSH push migration commands:

  mb-migrator push
  mb-migrator push-pair

The default guided flow prepares a key, waits while you install its public key
on the destination, asks for USER@HOST and port, verifies the connection, and
then runs the migration.

Advanced/retry commands:
  mb-migrator push-pair prepare [--state-dir=PATH]
  mb-migrator push-pair complete PAIRING_ID USER@HOST [--port=22]
  mb-migrator push-site [--pairing=PAIRING_ID] [--source-root=PATH] \
    [--target-root=PATH] [restore options]

The private pairing key remains on the source host. Install only the public key
printed by `push-pair prepare` on the destination SSH account.

Guided/push options:
  --destination=USER@HOST              Skip the destination login prompt
  --port=22                            Default: prompt with 22 as the default
  --new-pairing                        Ignore a saved current pairing
  --pairing=PAIRING_ID                 Default: saved current pairing
  --source-root=PATH                   Default: /var/www/webroot/ROOT
  --source-db-method=auto|wp-cli|native
                                       Default: auto
  --target-root=PATH                   Default: auto-detect destination root
  --new-url=URL                        Default: destination WP-CLI home URL
  --transport=auto|rsync|package       Default: auto (prefer rsync)
  --state-dir=PATH                     Persistent private pairing state

All other push-site options are forwarded to import-site on the destination.
EOF
}

default_state_dir() {
  if [[ -n "${XDG_STATE_HOME:-}" ]]; then
    printf '%s/mb-migrator\n' "$XDG_STATE_HOME"
  else
    printf '%s/.local/state/mb-migrator\n' "$HOME"
  fi
}

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else die "Required command not found: sha256sum or shasum"; fi
}

validate_pairing_id() {
  [[ "$1" =~ ^[a-f0-9]{20}$ ]] || die "Invalid pairing ID: $1"
}

validate_destination() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+@[A-Za-z0-9._-]+$ ]] || die "Invalid SSH destination: $1"
}

validate_port() {
  [[ "$1" =~ ^[0-9]+$ && "$1" -ge 1 && "$1" -le 65535 ]] || die "Invalid SSH port: $1"
}

pairing_dir() {
  local state_dir="$1" pairing_id="$2"
  validate_pairing_id "$pairing_id"
  printf '%s/push-pairings/%s\n' "$state_dir" "$pairing_id"
}

prepare_pairing() (
  local state_dir pairing_root pending key_file pairing_id final_dir public_key guided
  state_dir="$(default_state_dir)"
  guided=no
  set_log_context pairing key
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --state-dir=*) state_dir="${1#*=}" ;;
      --guided) guided=yes ;;
      --help|-h) usage; exit 0 ;;
      *) die "Unknown push-pair prepare option: $1" ;;
    esac
    shift
  done

  need_cmd ssh-keygen
  state_dir="$(abs_path_for_create "$state_dir")"
  pairing_root="$state_dir/push-pairings"
  mkdir -p "$state_dir" "$pairing_root"
  chmod 700 "$state_dir" "$pairing_root"
  pending="$(mktemp -d "$pairing_root/pending.XXXXXX")"
  trap 'rm -rf "$pending"' EXIT
  key_file="$pending/id_ed25519"
  ssh-keygen -q -t ed25519 -N '' -C "mb-migrator outbound push" -f "$key_file"
  chmod 600 "$key_file"
  chmod 644 "$key_file.pub"
  pairing_id="$(hash_file "$key_file.pub" | cut -c1-20)"
  final_dir="$pairing_root/$pairing_id"
  [[ ! -e "$final_dir" ]] || die "Pairing already exists: $pairing_id"
  mv "$pending" "$final_dir"
  trap - EXIT
  public_key="$(<"$final_dir/id_ed25519.pub")"
  printf '%s\n' "$pairing_id" > "$pairing_root/pending-pairing"
  chmod 600 "$pairing_root/pending-pairing"

  log "Pairing ID: $pairing_id"
  log "Private key stored on this source host: $final_dir/id_ed25519"
  printf '\nInstall this PUBLIC key on the new SSH account:\n\n%s\n\n' "$public_key"
  if [[ "$guided" == "yes" ]]; then
    printf 'Create or open the destination SSH account and add that public key.\n'
  else
    printf 'After creating the destination account, complete pairing with:\n\n'
    printf 'mb-migrator push-pair complete %s USER@HOST --port=22\n' "$pairing_id"
  fi
)

complete_pairing() {
  local pairing_id="${1:-}" destination="${2:-}" state_dir port pair_dir key_file ssh_dir
  local host host_lookup strict_policy scan_file pending_file pending_id
  [[ -n "$pairing_id" && -n "$destination" ]] || die "push-pair complete requires PAIRING_ID and USER@HOST"
  set_log_context pairing connect
  shift 2
  state_dir="$(default_state_dir)"
  port=22
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port=*) port="${1#*=}" ;;
      --state-dir=*) state_dir="${1#*=}" ;;
      --help|-h) usage; return 0 ;;
      *) die "Unknown push-pair complete option: $1" ;;
    esac
    shift
  done
  validate_destination "$destination"
  validate_port "$port"
  state_dir="$(abs_path_for_create "$state_dir")"
  pair_dir="$(pairing_dir "$state_dir" "$pairing_id")"
  key_file="$pair_dir/id_ed25519"
  [[ -f "$key_file" ]] || die "Pairing key not found for ID $pairing_id"
  chmod 600 "$key_file"
  ssh_dir="${MB_MIGRATOR_SSH_DIR:-$HOME/.ssh}"
  mkdir -p "$ssh_dir"
  chmod 700 "$ssh_dir"
  touch "$ssh_dir/known_hosts"
  chmod 600 "$ssh_dir/known_hosts"

  strict_policy="accept-new"
  if ! ssh -G -o StrictHostKeyChecking=accept-new "$destination" >/dev/null 2>&1; then
    strict_policy="yes"
    need_cmd ssh-keyscan
    host="${destination#*@}"
    if [[ "$port" == "22" ]]; then host_lookup="$host"
    else host_lookup="[$host]:$port"; fi
    if ! ssh-keygen -F "$host_lookup" -f "$ssh_dir/known_hosts" >/dev/null 2>&1; then
      scan_file="$(mktemp "${TMPDIR:-/tmp}/mb-push-host-key.XXXXXX")"
      if ! ssh-keyscan -T 10 -p "$port" "$host" > "$scan_file" 2>/dev/null || [[ ! -s "$scan_file" ]]; then
        rm -f "$scan_file"
        die "Could not retrieve the destination SSH host key"
      fi
      ssh-keygen -lf "$scan_file" || {
        rm -f "$scan_file"
        die "Destination returned an invalid SSH host key"
      }
      cat "$scan_file" >> "$ssh_dir/known_hosts"
      rm -f "$scan_file"
      warn "This older SSH client lacks accept-new; recorded the displayed destination host key"
    fi
  fi

  log "Verifying outbound SSH host key and key authentication"
  ssh -p "$port" -i "$key_file" \
    -o BatchMode=yes \
    -o IdentitiesOnly=yes \
    -o "StrictHostKeyChecking=$strict_policy" \
    -o "UserKnownHostsFile=$ssh_dir/known_hosts" \
    "$destination" true ||
    die "SSH verification failed; confirm the public key, username, hostname, and port"
  printf '%s\n' "$destination" > "$pair_dir/destination"
  printf '%s\n' "$port" > "$pair_dir/port"
  chmod 600 "$pair_dir/destination" "$pair_dir/port"
  printf '%s\n' "$pairing_id" > "$state_dir/push-pairings/current-pairing"
  chmod 600 "$state_dir/push-pairings/current-pairing"
  pending_file="$state_dir/push-pairings/pending-pairing"
  if [[ -r "$pending_file" ]]; then
    pending_id="$(<"$pending_file")"
    [[ "$pending_id" != "$pairing_id" ]] || rm -f "$pending_file"
  fi
  log "Push pairing verified: $pairing_id"
  log "Destination: $destination (port $port)"
}

prompt_value() {
  local variable_name="$1" message="$2" default_value="${3:-}" answer
  if [[ -n "$default_value" ]]; then
    printf '[%s:prompt] %s [%s]: ' "$(log_prefix)" "$message" "$default_value" >&2
  else
    printf '[%s:prompt] %s: ' "$(log_prefix)" "$message" >&2
  fi
  IFS= read -r answer || die "Input ended before the guided migration was complete"
  [[ -n "$answer" ]] || answer="$default_value"
  printf -v "$variable_name" '%s' "$answer"
}

guided_push() (
  local state_dir destination="" port="" source_root="" source_db_method="auto"
  local target_db_method="auto" pairing_id confirmation arg pairing_root pair_dir public_key
  local new_pairing="no" pairing_verified="no" restore_arg_count=0
  local -a push_args restore_args

  state_dir="$(default_state_dir)"
  restore_args=()
  set_log_context pairing guide
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --destination=*) destination="${1#*=}" ;;
      --port=*) port="${1#*=}" ;;
      --state-dir=*) state_dir="${1#*=}" ;;
      --source-root=*) source_root="${1#*=}" ;;
      --source-db-method=*) source_db_method="${1#*=}" ;;
      --target-db-method=*) target_db_method="${1#*=}" ;;
      --new-pairing) new_pairing=yes ;;
      --pairing=*) die "The guided flow creates a new pairing; use push-site to reuse one" ;;
      --help|-h) usage; exit 0 ;;
      *) restore_args+=("$1"); restore_arg_count=$((restore_arg_count + 1)) ;;
    esac
    shift
  done

  state_dir="$(abs_path_for_create "$state_dir")"
  pairing_root="$state_dir/push-pairings"
  pairing_id=""
  if [[ "$new_pairing" == "no" && -r "$pairing_root/pending-pairing" ]]; then
    pairing_id="$(<"$pairing_root/pending-pairing")"
    validate_pairing_id "$pairing_id"
    pair_dir="$(pairing_dir "$state_dir" "$pairing_id")"
    if [[ ! -f "$pair_dir/id_ed25519" || ! -f "$pair_dir/id_ed25519.pub" ||
      ( -f "$pair_dir/destination" && -f "$pair_dir/port" ) ]]; then
      pairing_id=""
    fi
  fi
  if [[ -z "$pairing_id" && "$new_pairing" == "no" &&
    -z "$destination" && -z "$port" && -r "$pairing_root/current-pairing" ]]; then
    pairing_id="$(<"$pairing_root/current-pairing")"
    validate_pairing_id "$pairing_id"
    pair_dir="$(pairing_dir "$state_dir" "$pairing_id")"
    if [[ -f "$pair_dir/id_ed25519" && -f "$pair_dir/destination" && -f "$pair_dir/port" ]]; then
      destination="$(<"$pair_dir/destination")"
      port="$(<"$pair_dir/port")"
      validate_destination "$destination"
      validate_port "$port"
      pairing_verified=yes
      log "Continuing with verified pairing: $destination (port $port)"
    else
      pairing_id=""
    fi
  fi
  if [[ "$pairing_verified" == "no" ]]; then
    if [[ -n "$pairing_id" ]]; then
      public_key="$(<"$pair_dir/id_ed25519.pub")"
      log "Resuming pending pairing: $pairing_id"
      printf '\nInstall this PUBLIC key on the new SSH account:\n\n%s\n\n' "$public_key"
      printf 'Create or open the destination SSH account and add that public key.\n'
    else
      prepare_pairing "--state-dir=$state_dir" --guided
      pairing_id="$(<"$pairing_root/pending-pairing")"
      validate_pairing_id "$pairing_id"
    fi
  fi

  if [[ "$pairing_verified" == "no" ]]; then
    printf '\n'
    printf '[%s:prompt] Press Enter to continue after the public key is installed: ' "$(log_prefix)" >&2
    IFS= read -r confirmation ||
      die "Input ended before the guided migration was complete"
    if [[ -z "$destination" ]]; then
      prompt_value destination "Destination SSH login (USER@HOST)"
    fi
    if [[ -z "$port" ]]; then
      prompt_value port "Destination SSH port" "22"
    fi
    validate_destination "$destination"
    validate_port "$port"
  fi

  if [[ -z "$source_root" ]]; then
    if [[ -d /var/www/webroot/ROOT ]]; then
      source_root=/var/www/webroot/ROOT
      set_log_context push discovery
      log "Using source WordPress root: $source_root"
    else
      set_log_context push discovery
      prompt_value source_root "Source WordPress root" "/var/www/webroot/ROOT"
    fi
  fi

  if [[ "$pairing_verified" == "no" ]]; then
    complete_pairing "$pairing_id" "$destination" "--port=$port" "--state-dir=$state_dir"
  fi
  push_args=(
    "--pairing=$pairing_id"
    "--state-dir=$state_dir"
    "--source-root=$source_root"
    "--source-db-method=$source_db_method"
    "--target-db-method=$target_db_method"
  )
  if [[ "$restore_arg_count" -gt 0 ]]; then
    for arg in "${restore_args[@]}"; do push_args+=("$arg"); done
  fi
  push_site "${push_args[@]}"
)

append_shell_arg() {
  local variable_name="$1" value="$2" quoted
  printf -v quoted '%q' "$value"
  printf -v "$variable_name" '%s %s' "${!variable_name}" "$quoted"
}

run_live_rsync() {
  local status=0 attempt=1 max_attempts="${RSYNC_MAX_ATTEMPTS:-4}" delay
  while :; do
    status=0
    rsync "$@" || status=$?
    case "$status" in
      0) return 0 ;;
      24)
        warn "Some source files vanished during rsync; continuing to the catch-up pass"
        return 0
        ;;
      10|11|12|30|35|255)
        if [[ "$attempt" -lt "$max_attempts" ]]; then
          delay=$((attempt * 2))
          warn "File-transfer connection was interrupted (rsync exit $status). Cached progress is safe; reconnecting in ${delay}s (attempt $((attempt + 1))/$max_attempts)"
          sleep "$delay"
          attempt=$((attempt + 1))
          continue
        fi
        warn "File transfer still failed after $max_attempts attempts (rsync exit $status)"
        warn "Already received files remain cached. Check destination disk/quota and SSH stability, then rerun 'push'; unchanged files will be skipped"
        ;;
      *)
        warn "Rsync stopped with exit $status. Cached files remain available for the next run"
        ;;
    esac
    return "$status"
  done
}

run_live_scp() {
  local status=0 attempt=1 max_attempts="${SCP_MAX_ATTEMPTS:-3}" delay
  while :; do
    status=0
    scp "$@" || status=$?
    [[ "$status" -ne 0 ]] || return 0
    if [[ "$attempt" -ge "$max_attempts" ]]; then
      warn "Small-file transfer failed after $max_attempts attempts (scp exit $status)"
      return "$status"
    fi
    delay=$((attempt * 2))
    warn "Small-file transfer was interrupted; reconnecting in ${delay}s (attempt $((attempt + 1))/$max_attempts)"
    sleep "$delay"
    attempt=$((attempt + 1))
  done
}

transfer_wp_content_batches() {
  local pass_name="$1" batch_root="$2" file_list batch_file batch_count batch_number=0
  local batch_size="${RSYNC_BATCH_SIZE:-250}"
  [[ "$batch_size" =~ ^[0-9]+$ && "$batch_size" -ge 25 && "$batch_size" -le 5000 ]] ||
    die "RSYNC_BATCH_SIZE must be between 25 and 5000"

  rm -rf "$batch_root"
  mkdir -p "$batch_root"
  file_list="$batch_root/all-files"
  (
    cd "$source_root"
    find wp-content \( -type f -o -type l \) -print | LC_ALL=C sort
  ) > "$file_list"

  if [[ ! -s "$file_list" ]]; then
    log "$pass_name: no wp-content files found"
    return 0
  fi
  awk -v size="$batch_size" -v root="$batch_root" '
    {
      output = sprintf("%s/batch.%06d", root, int((NR - 1) / size) + 1)
      if (output != previous && previous != "") close(previous)
      print > output
      previous = output
    }
    END { if (previous != "") close(previous) }
  ' "$file_list"
  batch_count="$(find "$batch_root" -type f -name 'batch.*' | wc -l | tr -d '[:space:]')"
  for batch_file in "$batch_root"/batch.*; do
    batch_number=$((batch_number + 1))
    log "$pass_name: file batch $batch_number/$batch_count"
    run_live_rsync "${rsync_args[@]}" "--link-dest=$target_root/wp-content" \
      --files-from="$batch_file" --relative -e "$ssh_transport" \
      "$source_root/" "$destination:$remote_stage/htdocs/"
  done
}

push_site() (
  local pairing_id="" source_root="" source_db_method="auto" target_root="" new_url=""
  local transport="auto" selected_transport state_dir pair_dir key_file destination port ssh_dir work package
  local remote_output remote_dir remote_package remote_stage remote_runner remote_command import_command cleanup_command url_command login_command
  local repo ref arg option_name detected_url quoted_target source_url ssh_transport remote_prepare remote_rsync_path=""
  local rsync_batch_root
  local restore_arg_count=0 cleanup_specified=no remote_cache_reused=0
  local db_attempt db_dump_status db_ssh_status destination_free_kb source_content_kb
  local rsync_help wp_content_ready=no
  local -a restore_args ssh_args scp_args rsync_args pipeline_status

  state_dir="$(default_state_dir)"
  set_log_context push setup
  restore_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --pairing=*) pairing_id="${1#*=}" ;;
      --source-root=*) source_root="${1#*=}" ;;
      --source-db-method=*) source_db_method="${1#*=}" ;;
      --target-root=*) target_root="${1#*=}"; restore_args+=("$1"); restore_arg_count=$((restore_arg_count + 1)) ;;
      --new-url=*) new_url="${1#*=}"; restore_args+=("$1"); restore_arg_count=$((restore_arg_count + 1)) ;;
      --transport=*) transport="${1#*=}" ;;
      --state-dir=*) state_dir="${1#*=}" ;;
      --cleanup=*) restore_args+=("$1"); restore_arg_count=$((restore_arg_count + 1)); cleanup_specified=yes ;;
      --help|-h) usage; exit 0 ;;
      --provider=*) die "push-site selects the wordpress-package provider automatically" ;;
      *) restore_args+=("$1"); restore_arg_count=$((restore_arg_count + 1)) ;;
    esac
    shift
  done

  case "$source_db_method" in auto|wp-cli|native) ;; *) die "Invalid source database method: $source_db_method" ;; esac
  case "$transport" in auto|rsync|package) ;; *) die "Invalid transport: $transport" ;; esac
  state_dir="$(abs_path_for_create "$state_dir")"
  if [[ -z "$pairing_id" && -r "$state_dir/push-pairings/current-pairing" ]]; then
    pairing_id="$(<"$state_dir/push-pairings/current-pairing")"
    validate_pairing_id "$pairing_id"
    log "Using current pairing: $pairing_id"
  fi
  [[ -n "$pairing_id" ]] ||
    die "No current pairing found. Run 'mb-migrator push' or pass --pairing"
  if [[ -z "$source_root" && -d /var/www/webroot/ROOT ]]; then
    source_root=/var/www/webroot/ROOT
    log "Using source WordPress root: $source_root"
  fi
  [[ -n "$source_root" ]] ||
    die "Could not find /var/www/webroot/ROOT; pass --source-root"
  pair_dir="$(pairing_dir "$state_dir" "$pairing_id")"
  key_file="$pair_dir/id_ed25519"
  [[ -f "$key_file" && -f "$pair_dir/destination" && -f "$pair_dir/port" ]] ||
    die "Pairing is incomplete. Run push-pair complete for ID $pairing_id"
  destination="$(<"$pair_dir/destination")"
  port="$(<"$pair_dir/port")"
  validate_destination "$destination"
  validate_port "$port"
  chmod 600 "$key_file"
  ssh_dir="${MB_MIGRATOR_SSH_DIR:-$HOME/.ssh}"
  [[ -f "$ssh_dir/known_hosts" ]] || die "SSH known_hosts file is missing; rerun push-pair complete"

  need_cmd ssh
  ssh_args=(-p "$port" -i "$key_file" -o BatchMode=yes -o IdentitiesOnly=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=8 -o TCPKeepAlive=yes -o ConnectTimeout=20 -o "UserKnownHostsFile=$ssh_dir/known_hosts")
  scp_args=(-P "$port" -i "$key_file" -o BatchMode=yes -o IdentitiesOnly=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=8 -o TCPKeepAlive=yes -o ConnectTimeout=20 -o "UserKnownHostsFile=$ssh_dir/known_hosts")
  set_log_phase connect
  log "Verifying saved SSH pairing"
  ssh "${ssh_args[@]}" "$destination" true || die "Saved SSH pairing could not connect"

  set_log_phase discovery
  if [[ -z "$target_root" ]]; then
    remote_output="$(ssh "${ssh_args[@]}" "$destination" \
      'target=""; if [ -d /srv/htdocs ] && [ -f /srv/htdocs/wp-config.php ]; then target=/srv/htdocs; elif [ -d "$HOME/htdocs" ] && [ -f "$HOME/htdocs/wp-config.php" ]; then target="$(readlink -f "$HOME/htdocs" 2>/dev/null || printf "%s" "$HOME/htdocs")"; fi; printf "__MB_TARGET_ROOT__=%s\n" "$target"')"
    target_root="$(printf '%s\n' "$remote_output" | tr -d '\r' |
      awk -F= '/^__MB_TARGET_ROOT__=/{value=$2} END{print value}')"
    if [[ ! "$target_root" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
      if [[ -t 0 ]]; then
        prompt_value target_root "Destination WordPress root" "/srv/htdocs"
      else
        die "Could not auto-detect the destination WordPress root; pass --target-root explicitly"
      fi
    fi
    [[ "$target_root" =~ ^/[A-Za-z0-9._/-]+$ ]] ||
      die "Invalid destination WordPress root: $target_root"
    restore_args+=("--target-root=$target_root")
    restore_arg_count=$((restore_arg_count + 1))
    log "Using destination root: $target_root"
  fi

  if [[ -z "$new_url" ]]; then
    printf -v quoted_target '%q' "$target_root"
    for option_name in siteurl home; do
      printf -v url_command 'cd %s && wp option get %q' "$quoted_target" "$option_name"
      printf -v login_command 'bash -lc %q' "$url_command"
      if ! detected_url="$(ssh "${ssh_args[@]}" "$destination" "$login_command" |
        tr -d '\r' | awk 'NF{value=$0} END{print value}')"; then
        detected_url=""
      fi
      if [[ "$detected_url" =~ ^https?://[^[:space:]]+$ ]]; then
        new_url="$detected_url"
        break
      fi
    done
    if [[ ! "$new_url" =~ ^https?://[^[:space:]]+$ ]]; then
      if [[ -t 0 ]]; then
        prompt_value new_url "Destination site URL (including https://)"
      else
        die "Could not detect destination home or siteurl with WP-CLI; pass --new-url explicitly"
      fi
    fi
    [[ "$new_url" =~ ^https?://[^[:space:]]+$ ]] ||
      die "Invalid destination site URL: $new_url"
    restore_args+=("--new-url=$new_url")
    restore_arg_count=$((restore_arg_count + 1))
    log "Using destination URL: $new_url"
  fi

  set_log_phase transport
  selected_transport="$transport"
  if [[ "$selected_transport" == "auto" ]]; then
    if command -v rsync >/dev/null 2>&1; then
      remote_rsync_path="$(ssh "${ssh_args[@]}" "$destination" "bash -lc 'command -v rsync'" 2>/dev/null |
        tr -d '\r' | awk 'NF{value=$0} END{print value}')"
    fi
    if [[ "$remote_rsync_path" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
      selected_transport="rsync"
    else
      selected_transport="package"
      warn "rsync is unavailable on one host; falling back to portable package transfer"
    fi
  elif [[ "$selected_transport" == "rsync" ]]; then
    command -v rsync >/dev/null 2>&1 || die "rsync transport requested, but rsync is unavailable on the source"
    remote_rsync_path="$(ssh "${ssh_args[@]}" "$destination" "bash -lc 'command -v rsync'" 2>/dev/null |
      tr -d '\r' | awk 'NF{value=$0} END{print value}')"
    [[ "$remote_rsync_path" =~ ^/[A-Za-z0-9._/-]+$ ]] ||
      die "rsync transport requested, but rsync is unavailable on the destination"
  fi

  work="$(mktemp -d "${MB_MIGRATOR_TMPDIR:-${TMPDIR:-/tmp}}/mb-push-site.XXXXXX")"
  trap 'rm -rf "$work"' EXIT

  set_log_phase transfer
  log "Creating private incoming directory on destination"
  if [[ "$selected_transport" == "rsync" ]]; then
    remote_output="$(ssh "${ssh_args[@]}" "$destination" \
      "umask 077; incoming=\"\$HOME/.local/state/mb-migrator/incoming\"; mkdir -p \"\$incoming\"; chmod 700 \"\$HOME/.local/state\" \"\$HOME/.local/state/mb-migrator\" \"\$incoming\" 2>/dev/null || true; dir=\"\$incoming/rsync-$pairing_id\"; reused=0; [ ! -d \"\$dir/staged-site/htdocs\" ] || reused=1; mkdir -p \"\$dir\"; printf '__MB_REMOTE_DIR__=%s\\n__MB_CACHE_REUSED__=%s\\n' \"\$dir\" \"\$reused\"")"
  else
    remote_output="$(ssh "${ssh_args[@]}" "$destination" \
      'umask 077; incoming="$HOME/.local/state/mb-migrator/incoming"; mkdir -p "$incoming"; chmod 700 "$HOME/.local/state" "$HOME/.local/state/mb-migrator" "$incoming" 2>/dev/null || true; dir="$(mktemp -d "$incoming/push.XXXXXX")"; printf "__MB_REMOTE_DIR__=%s\n" "$dir"')"
  fi
  remote_dir="$(printf '%s\n' "$remote_output" | tr -d '\r' | awk -F= '/^__MB_REMOTE_DIR__=/{value=$2} END{print value}')"
  remote_cache_reused="$(printf '%s\n' "$remote_output" | tr -d '\r' | awk -F= '/^__MB_CACHE_REUSED__=/{value=$2} END{print value}')"
  [[ "$remote_dir" =~ ^/[A-Za-z0-9._/-]+/\.local/state/mb-migrator/incoming/(push\.[A-Za-z0-9]+|rsync-[a-f0-9]{20})$ ]] ||
    die "Destination returned an unsafe incoming path"
  remote_package="$remote_dir/wordpress-package.tar.gz"
  remote_stage="$remote_dir/staged-site"
  remote_runner="$remote_dir/remote-run.sh"

  repo="${MB_MIGRATOR_REPO:-mightybox-io/mb-migrator}"
  ref="${MB_MIGRATOR_REF:-main}"
  [[ "$repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]] || die "Invalid repository name: $repo"
  [[ "$ref" =~ ^[A-Za-z0-9._/-]+$ ]] || die "Invalid repository ref: $ref"

  need_cmd scp
  if [[ "$selected_transport" == "rsync" ]]; then
    log "Transport: direct rsync over SSH"
    if [[ "$remote_cache_reused" == "1" ]]; then
      log "Reusing persistent destination cache; unchanged files will not be retransferred"
    else
      log "Initialized persistent destination cache for incremental retries"
    fi
    set_log_phase preflight
    log "Preflighting WordPress source"
    bash "$ROOT_DIR/lib/remote-source.sh" preflight "$source_root" "$source_db_method"

    printf -v remote_prepare 'umask 077; mkdir -p %q %q %q' \
      "$remote_stage" "$remote_stage/htdocs" "$remote_stage/database-package"
    ssh "${ssh_args[@]}" "$destination" "$remote_prepare"

    remote_output="$(ssh "${ssh_args[@]}" "$destination" "df -Pk '$remote_stage' 2>/dev/null | awk 'NR==2 {print \"__MB_FREE_KB__=\" \$4}'")"
    destination_free_kb="$(printf '%s\n' "$remote_output" | tr -d '\r' | awk -F= '/^__MB_FREE_KB__=/{value=$2} END{print value}')"
    source_content_kb="$(du -sk "$source_root/wp-content" 2>/dev/null | awk 'NR==1{print $1}')"
    if [[ "$destination_free_kb" =~ ^[0-9]+$ && "$source_content_kb" =~ ^[0-9]+$ ]]; then
      log "Capacity check: source wp-content is approximately $((source_content_kb / 1024)) MiB; destination cache has $((destination_free_kb / 1024)) MiB free"
      if [[ "$destination_free_kb" -lt "$source_content_kb" ]]; then
        warn "Destination free space is smaller than the source wp-content size; link reuse may still make it fit, but quota should be watched"
      fi
    fi

    printf -v ssh_transport 'ssh -p %q -i %q -o BatchMode=yes -o IdentitiesOnly=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=8 -o TCPKeepAlive=yes -o ConnectTimeout=20 -o UserKnownHostsFile=%q' \
      "$port" "$key_file" "$ssh_dir/known_hosts"
    rsync_args=(-azr --partial --partial-dir=.mb-migrator-partial --timeout=120 --no-perms --no-owner --no-group --omit-dir-times "--rsync-path=$remote_rsync_path")
    rsync_help="$(rsync --info=help 2>&1 || true)"
    if [[ "$rsync_help" == *progress2* ]]; then
      rsync_args+=(--human-readable --info=name0,progress2)
    else
      rsync_args+=(--progress)
    fi
    rsync_batch_root="$work/rsync-batches"

    set_log_phase files
    if [[ "$remote_cache_reused" == "1" ]]; then
      log "Checking whether the existing cache can be refreshed in one short incremental pass"
      if RSYNC_MAX_ATTEMPTS=1 run_live_rsync "${rsync_args[@]}" "--link-dest=$target_root/wp-content" -e "$ssh_transport" \
        "$source_root/wp-content/" "$destination:$remote_stage/htdocs/wp-content/"; then
        wp_content_ready=yes
        log "Existing cache refreshed without batching"
      else
        warn "The cache still needs substantial work; switching to gateway-safe file batches"
      fi
    fi
    if [[ "$wp_content_ready" == "no" ]]; then
      log "Rsync pass 1 of 2: WordPress files in gateway-safe batches"
      transfer_wp_content_batches "Pass 1" "$rsync_batch_root"
    fi
    run_live_rsync "${rsync_args[@]}" "--link-dest=$target_root" -e "$ssh_transport" \
      --exclude='*/' \
      --exclude='index.php' \
      --exclude='license.txt' \
      --exclude='readme.html' \
      --exclude='wp-*.php' \
      --exclude='xmlrpc.php' \
      --exclude='wp-config.php' \
      --exclude='wordpress-package-*.tar.gz' \
      --exclude='wordpress-package-*.tar.gz.sha256' \
      "$source_root/" "$destination:$remote_stage/htdocs/"

    if [[ "$wp_content_ready" == "no" ]]; then
      log "Rsync pass 2 of 2: catching files changed during the first pass"
      run_live_rsync "${rsync_args[@]}" "--link-dest=$target_root/wp-content" -e "$ssh_transport" \
        "$source_root/wp-content/" "$destination:$remote_stage/htdocs/wp-content/"
    fi
    run_live_rsync "${rsync_args[@]}" "--link-dest=$target_root" -e "$ssh_transport" \
      --exclude='*/' \
      --exclude='index.php' \
      --exclude='license.txt' \
      --exclude='readme.html' \
      --exclude='wp-*.php' \
      --exclude='xmlrpc.php' \
      --exclude='wp-config.php' \
      --exclude='wordpress-package-*.tar.gz' \
      --exclude='wordpress-package-*.tar.gz.sha256' \
      "$source_root/" "$destination:$remote_stage/htdocs/"

    set_log_phase database
    db_attempt=1
    while :; do
      log "Streaming fresh database export to destination (attempt $db_attempt/3)"
      set +e
      bash "$ROOT_DIR/lib/remote-source.sh" export-db "$source_root" "$source_db_method" |
        ssh "${ssh_args[@]}" "$destination" \
          "umask 077; output='$remote_stage/database-package/site.sql'; temp=\"\$output.partial\"; cat > \"\$temp\" && mv \"\$temp\" \"\$output\""
      pipeline_status=("${PIPESTATUS[@]}")
      set -e
      db_dump_status="${pipeline_status[0]}"
      db_ssh_status="${pipeline_status[1]}"
      if [[ "$db_dump_status" -eq 0 && "$db_ssh_status" -eq 0 ]]; then
        break
      fi
      if [[ "$db_dump_status" -ne 0 ]]; then
        die "Source database export failed (exit $db_dump_status). The file cache is safe; fix the database error and rerun 'push'"
      fi
      if [[ "$db_attempt" -ge 3 ]]; then
        die "Database stream could not stay connected after 3 attempts (SSH exit $db_ssh_status). The file cache is safe; rerun 'push' when SSH is stable"
      fi
      warn "Database stream was interrupted (SSH exit $db_ssh_status); restarting the fresh export"
      sleep $((db_attempt * 2))
      db_attempt=$((db_attempt + 1))
    done

    source_url="$(bash "$ROOT_DIR/lib/remote-source.sh" get-url "$source_root" "$source_db_method" 2>/dev/null || true)"
    [[ "$source_url" != *$'\n'* && "$source_url" != *$'\r'* ]] ||
      die "Detected source URL contains newlines"
    {
      printf 'format=mb-wordpress-package-v1\n'
      printf 'source_root=%s\n' "$source_root"
      [[ -z "$source_url" ]] || printf 'source_url=%s\n' "$source_url"
      printf 'created_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$work/mb-wordpress-package-manifest"
    chmod 600 "$work/mb-wordpress-package-manifest"

    set_log_phase transfer
    log "Transferring migration metadata and runner"
    run_live_scp "${scp_args[@]}" "$work/mb-wordpress-package-manifest" \
      "$destination:$remote_stage/mb-wordpress-package-manifest"
    run_live_scp "${scp_args[@]}" "$ROOT_DIR/remote-run.sh" "$destination:$remote_runner"

    printf -v import_command 'MB_MIGRATOR_REPO=%q MB_MIGRATOR_REF=%q bash %q' "$repo" "$ref" "$remote_runner"
    append_shell_arg import_command import-staged
    append_shell_arg import_command "$remote_stage"
  else
    set_log_phase package
    log "Transport: portable package over SSH"
    package="$work/wordpress-package.tar.gz"
    "$ROOT_DIR/bin/mb-package" export-site \
      "--source-root=$source_root" \
      "--output=$package" \
      "--db-method=$source_db_method"
    log "Transferring package, checksum, and migration runner over SSH"
    run_live_scp "${scp_args[@]}" "$package" "$package.sha256" "$ROOT_DIR/remote-run.sh" "$destination:$remote_dir/"
    printf -v import_command 'MB_MIGRATOR_REPO=%q MB_MIGRATOR_REF=%q bash %q' "$repo" "$ref" "$remote_runner"
    append_shell_arg import_command import-site
    append_shell_arg import_command "$remote_package"
  fi

  if [[ "$selected_transport" == "rsync" && "$cleanup_specified" == "no" ]]; then
    restore_args+=("--cleanup=no")
    restore_arg_count=$((restore_arg_count + 1))
  fi
  if [[ "$restore_arg_count" -gt 0 ]]; then
    for arg in "${restore_args[@]}"; do append_shell_arg import_command "$arg"; done
  fi
  printf -v remote_command 'bash -lc %q' "$import_command"

  set_log_phase restore
  log "Starting destination import"
  if [[ -t 0 && -t 1 ]]; then
    ssh -t "${ssh_args[@]}" "$destination" "$remote_command" || {
      warn "Destination import failed; transferred migration data retained at: $destination:$remote_dir"
      exit 1
    }
  elif ! ssh "${ssh_args[@]}" "$destination" "$remote_command"; then
    warn "Destination import failed; transferred migration data retained at: $destination:$remote_dir"
    exit 1
  fi

  set_log_phase cleanup
  printf -v cleanup_command 'rm -f %q %q %q; rmdir %q 2>/dev/null || true' \
    "$remote_package" "$remote_package.sha256" "$remote_runner" "$remote_dir"
  ssh "${ssh_args[@]}" "$destination" "$cleanup_command" ||
    warn "Migration succeeded, but destination runner cleanup failed: $remote_dir"
  set_log_phase complete
  log "Push migration completed"
)

command_name="${1:-}"
[[ -z "$command_name" ]] || shift
case "$command_name" in
  push) guided_push "$@" ;;
  push-pair)
    action="${1:-}"
    [[ -z "$action" ]] || shift
    case "$action" in
      prepare) prepare_pairing "$@" ;;
      complete) complete_pairing "$@" ;;
      --help|-h) usage ;;
      '') guided_push "$@" ;;
      *) die "Unknown push-pair action: $action" ;;
    esac
    ;;
  push-site) push_site "$@" ;;
  --help|-h|'') usage ;;
  *) die "Unknown push migration command: $command_name" ;;
esac
